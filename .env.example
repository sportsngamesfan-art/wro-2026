# Copy this file to .env and adjust values for your machine.
# Stage 1 (bench testing) needs no secrets -- these are local run settings only.

# "laptop" runs everything against mock hardware; "pi" is set automatically
# by platform detection in each src/ module, but can be forced here for testing.
BHASHASETU_ENV=laptop

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SQLite database location (relative to project root)
DATABASE_PATH=data/bhashasetu.db

# Directory where recorded utterances are written
RECORDINGS_DIR=data/test_audio
